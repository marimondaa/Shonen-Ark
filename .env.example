# ==============================================================================
# 🌸 Shonen Ark - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local: `cp .env.example .env.local`
# 2. Fill in your actual values for local development.
# 3. DO NOT commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 Core Authentication (NextAuth)
# ------------------------------------------------------------------------------
# NEXTAUTH_URL: The base URL of the app (e.g., http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: Secret for session signing. Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_key_here

# ------------------------------------------------------------------------------
# 💾 Database & Storage (Supabase)
# ------------------------------------------------------------------------------
# Get these from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role key has admin access. NEVER expose this on the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------------------------------------------
# ⚙️ Back-Office Automation (n8n)
# ------------------------------------------------------------------------------
# N8N_URL: Base URL of your n8n instance
N8N_URL=https://n8n.your-domain.com
# N8N_API_KEY: Personal access token (n8n Settings -> API Keys)
N8N_API_KEY=your_n8n_api_key
# WEBHOOK_SECRET: Shared secret for Shonen Ark -> n8n HMAC signatures. Use a random string.
WEBHOOK_SECRET=your_webhook_secret_for_hmac

# ------------------------------------------------------------------------------
# 💳 Payments (Stripe) - [OPTIONAL]
# ------------------------------------------------------------------------------
# Get these from Stripe Dashboard -> Developers -> API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET: Required for subscription sync (Stripe CLI or Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 🤖 AI & Metadata - [OPTIONAL]
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Required for AI analysis features (https://platform.openai.com)
OPENAI_API_KEY=sk-...
# CLOUDINARY: For image/video hosting (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ANILIST: For release calendar metadata (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=your_anilist_id
ANILIST_CLIENT_SECRET=your_anilist_secret

# ------------------------------------------------------------------------------
# 🔑 OAuth Providers - [OPTIONAL]
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID & SECRET: (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_id
GOOGLE_CLIENT_SECRET=your_google_secret
# DISCORD_CLIENT_ID & SECRET: (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_id
DISCORD_CLIENT_SECRET=your_discord_secret
