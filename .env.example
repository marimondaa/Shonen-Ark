# Required only for account and persistent community features.
# Copy to .env.local, fill locally, and restart/rebuild Next.js.
# Public Supabase anon or publishable key only. NEVER use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AniList's public catalog requires no key.
# Apply supabase/mvp.sql to a test project before checking community workflows.
